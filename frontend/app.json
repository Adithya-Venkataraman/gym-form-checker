{
  "expo": {
    "name": "Gym Form Checker",
    "slug": "gym-form-checker",
    "version": "1.0.0",
    "updates": {
      "enabled": false
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymformchecker.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Gym Form Checker uses your camera to analyze exercise form in real-time.",
        "NSMicrophoneUsageDescription": "Microphone access may be requested by the camera.",
        "NSPhotoLibraryUsageDescription": "Allow access to select workout videos for analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F12"
      },
      "package": "com.gymformchecker.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "gymformchecker",
    "extra": {
      "eas": {
        "projectId": "e1d3b3a0-084b-480e-be4e-0024bf6c3985"
      }
    }
  }
}