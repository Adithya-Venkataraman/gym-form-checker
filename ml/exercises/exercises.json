    "squat": {
      "id": "squat",
      "name": "Squat",
      "aliases": ["bodyweight squat", "air squat", "back squat", "goblet squat"],
      "preferred_view": "side",
      "view_warning": "Side view gives significantly better form feedback for squats",
      "key_joints": ["left_hip", "left_knee", "left_ankle", "right_hip", "right_knee", "right_ankle"],
      "rep_logic": {
        "tracking_joint": "left_knee",
        "landmarks": ["left_hip", "left_knee", "left_ankle"],
        "down_threshold": 100,
        "up_threshold": 160,
        "direction": "decrease_to_down"
      },
      "auto_detection": {
        "primary_landmarks": ["left_hip", "left_knee", "left_ankle"],
        "motion_range": 65,
        "min_reps_to_confirm": 2
      },
      "rules": {
        "beginner": [
          {
            "joint": "left_knee",
            "landmarks": ["left_hip", "left_knee", "left_ankle"],
            "phase": "bottom",
            "min_angle": 80,
            "feedback": "Go a bit lower — aim for thighs parallel to floor",
            "severity": "low"
          },
          {
            "joint": "left_hip",
            "landmarks": ["left_shoulder", "left_hip", "left_knee"],
            "phase": "any",
            "min_angle": 45,
            "max_angle": 120,
            "feedback": "Keep your chest up and back straight",
            "severity": "medium",
            "injury_warning": "Excessive forward lean puts stress on your lower back"
          }
        ],
        "intermediate": [
          {
            "joint": "left_knee",
            "landmarks": ["left_hip", "left_knee", "left_ankle"],
            "phase": "bottom",
            "min_angle": 70,
            "feedback": "Go lower — aim for parallel or below",
            "severity": "medium"
          },
          {
            "joint": "left_hip",
            "landmarks": ["left_shoulder", "left_hip", "left_knee"],
            "phase": "any",
            "min_angle": 45,
            "max_angle": 110,
            "feedback": "Keep your torso more upright",
            "severity": "medium"
          },
          {
            "joint": "right_knee",
            "landmarks": ["right_hip", "right_knee", "right_ankle"],
            "phase": "bottom",
            "min_angle": 70,
            "feedback": "Knees collapsing inward — push them out",
            "severity": "high",
            "injury_warning": "Risk of knee strain — knees should track over toes"
          }
        ],
        "advanced": [
          {
            "joint": "left_knee",
            "landmarks": ["left_hip", "left_knee", "left_ankle"],
            "phase": "bottom",
            "min_angle": 60,
            "feedback": "Not reaching full depth",
            "severity": "medium"
          },
          {
            "joint": "left_hip",
            "landmarks": ["left_shoulder", "left_hip", "left_knee"],
            "phase": "any",
            "min_angle": 40,
            "max_angle": 100,
            "feedback": "Maintain a perfectly upright torso",
            "severity": "high"
          }
        ]
      },
      "feedback_messages": {
        "good_rep": ["Great rep!", "Perfect depth!", "Solid form!", "Clean squat!"],
        "encouragement": ["Keep going!", "You've got this!", "Stay strong!", "Drive through!"]
      }
    },
